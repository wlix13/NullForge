# Managed by NullForge. Local edits are overwritten on redeploy.

[general]
fast_mode = {{ FAST_MODE | lower }}
use_middle_proxy = {{ USE_MIDDLE_PROXY | lower }}
log_level = "silent"
{% if WEB_ENABLED %}

[general.links]
show = "*"
{% endif %}

[general.modes]
classic = {{ MODE_CLASSIC | lower }}
secure = {{ MODE_SECURE | lower }}
tls = {{ MODE_TLS | lower }}

[server]
max_connections = {{ MAX_CONNECTIONS }}
port = {{ PORT }}

[server.api]
enabled = {{ API_ENABLED | lower }}
{% if WEB_ENABLED %}

[[server.listeners]]
ip = "127.0.0.1"
port = {{ WEB_PORT }}
transport = "web"
proxy_protocol = false
web_client_ip_source = "x_forwarded_for"
web_trusted_proxy_cidrs = ["127.0.0.1/32"]

[web]
enabled = true
carrier = "{{ WEB_CARRIER }}"

[[web.vhosts]]
host = "{{ WEB_HOST }}"
{% if WEB_BASE_PATH %}base_path = "{{ WEB_BASE_PATH }}"
{% endif %}public_addr = "{{ WEB_PUBLIC_ADDR }}"

[web.vhosts.decoy]
mode = "http_upstream"
upstream = "http://127.0.0.1:{{ DECOY_PORT }}"

{% for WEB_USER in WEB_USERS %}
[[web.vhosts.profiles]]
user = "{{ WEB_USER }}"
secret_mode = "dd"
max_sessions = 8
max_streams = 512
max_streams_per_session = 64
{% endfor %}
{% endif %}

[network]
ipv6 = {{ IPV6 | lower }}
prefer = {{ PREFER }}

[timeouts]
client_handshake = {{ CLIENT_HANDSHAKE }}

[censorship]
tls_domain = "{{ TLS_DOMAIN }}"
{% if UNKNOWN_SNI_ACTION %}
unknown_sni_action = "{{ UNKNOWN_SNI_ACTION }}"
{% else %}
#unknown_sni_action = "mask"
{% endif %}

[access.users]
{% for name, secret in USERS.items() %}
{{ name }} = "{{ secret }}"
{% endfor %}

[[upstreams]]
type = "direct"
{% if ROUTE_VIA_WARP %}
# Egress is steered through WARP by teleproxy-warp.sh (per-uid policy routing),
# so the upstream stays "direct" instead of binding to the "{{ WARP_IFACE }}" interface.
{% else %}
#interface = "{{ WARP_IFACE }}"
{% endif %}
weight = 10
enabled = true
