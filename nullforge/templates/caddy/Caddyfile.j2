# Managed by NullForge. Local edits are overwritten on redeploy.

{{ WEB_HOST }} {
	reverse_proxy 127.0.0.1:{{ WEB_PORT }} {
		header_up X-Forwarded-For {remote_host}
	}
}

# Loopback-only decoy origin for non-carrier requests.
http://127.0.0.1:{{ DECOY_PORT }} {
	bind 127.0.0.1
	root * {{ DECOY_DIR }}
	file_server
}
