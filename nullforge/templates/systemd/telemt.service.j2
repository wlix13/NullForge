[Unit]
Description=Telemt MTProto proxy
Wants=network-online.target
After=network-online.target{% if WARP_ENABLED %} {{ WARP_SERVICE }}.service{% endif %}

{% if WARP_ENABLED %}
Requires={{ WARP_SERVICE }}.service
BindsTo={{ WARP_SERVICE }}.service
{% endif %}

[Service]
Type=simple
User={{ USER }}
Group={{ GROUP }}
ExecStart={{ BINARY_PATH }} {{ CONFIG_PATH }}
{% if WARP_ENABLED %}
ExecStartPre=+{{ TELEPROXY_SCRIPT }} up {{ USER }} {{ WARP_IFACE }}
{% endif %}
{% if SYNFIX_ENABLED %}
ExecStartPre=+{{ SYNFIX_SCRIPT }} up {{ PORT }}
ExecStopPost=+{{ SYNFIX_SCRIPT }} down {{ PORT }}
{% endif %}
{% if WARP_ENABLED %}
ExecStopPost=+{{ TELEPROXY_SCRIPT }} down {{ USER }} {{ WARP_IFACE }}
{% endif %}
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
